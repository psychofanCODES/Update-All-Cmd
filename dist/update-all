  done < <(printf '%s\n' "$out" | sed -nE 's/^[[:space:]]*([A-Za-z0-9_.@\/-]+)[[:space:]]+([0-9][^[:space:]]*)[[:space:]]+->[[:space:]]+([0-9][^[:space:]()]*).*/\1|\2|\3/p')
