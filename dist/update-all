      ncolors="$(tput colors 2>/dev/null || echo 0)"
    else
      case "${TERM:-}" in
        *256color*|*truecolor*|*direct*) ncolors=256 ;;
        ""|dumb) ncolors=0 ;;
        *) ncolors=8 ;;
      esac
    fi
  fi

  case "${ncolors:-0}" in
    *[!0-9]*|"") ncolors=0 ;;
