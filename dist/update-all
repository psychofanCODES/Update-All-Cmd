  done < <(printf '%s\n' "$out" | sed -nE 's/^[[:space:]]*(@?[A-Za-z0-9_.-]+(\/[A-Za-z0-9_.-]+)?)[[:space:]]+([0-9][^[:space:]]*)[[:space:]]+->[[:space:]]+([0-9][^[:space:]()]*).*/\1|\3|\4/p')
