ua_rule_line() {
  local width="${1:-}" char="${2:-${G_RULE:-─}}" spaces
  if [ -z "$width" ]; then
    if declare -F tui_rule_width >/dev/null 2>&1; then
      width="$(tui_rule_width)"
    else
      width=88
    fi
  fi
  case "$width" in
    *[!0-9]*|"") width=88 ;;
  esac
  [ "$width" -gt 0 ] || return 0
  printf -v spaces '%*s' "$width" ''
  printf '%s' "${spaces// /$char}"
}

intro() {
