glyphs_init() {
  local locale="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
  _ua_utf8=0
  if [ "${UPDATE_ALL_ASCII:-0}" != "1" ]; then
    case "$locale" in
      *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*)
        _ua_utf8=1
        ;;
    esac
  fi

  if [ "$_ua_utf8" -eq 1 ]; then
    G_UPDATED="↗"
    G_OK="✓"
    G_UNCHANGED="="
    G_FAIL="✗"
    G_SKIP="·"
    G_WARN="▲"
    G_SAFETY="◆"
    G_ARROW="→"
    G_GUTTER="│"
    G_CARD="▌"
    G_LIVE="●"
    G_IDLE="○"
    G_BAR_FULL="█"
    G_BAR_EMPTY="░"
    G_RULE="─"
    G_DOCK_RULE="━"
  else
    G_UPDATED="^"
    G_OK="+"
    G_UNCHANGED="="
    G_FAIL="x"
    G_SKIP="."
    G_WARN="!"
    G_SAFETY="*"
    G_ARROW="->"
    G_GUTTER="|"
    G_CARD=">"
    G_LIVE="*"
    G_IDLE="o"
    G_BAR_FULL="#"
    G_BAR_EMPTY="-"
    G_RULE="-"
    G_DOCK_RULE="="
  fi
}

color_init() {
  local ncolors=0
  glyphs_init

  if [ "${UPDATE_ALL_COLOR:-1}" = "1" ] && [ -z "${NO_COLOR:-}" ] && [ -t 1 ]; then
