}

pending_update_line() {
  local name="$1" old="$2" new="$3"
  printf '      %s %b%s%b %b->%b %b%s%b\n' \
    "$(styled_package_name "$name" 30)" \
    "$C_VERSION_BEFORE" "$old" "$C_RESET" \
    "$C_FRAME" "$C_RESET" \
    "$C_VERSION_AFTER" "$new" "$C_RESET"
}

pending_update_note() {
  printf '      %b%s%b\n' "$C_TIP" "$1" "$C_RESET"
}

glyphs_init

# ===== MODULE: lib/tui.sh =====
# lib/tui.sh - Persistent DECSTBM 2-row TUI dock, kinetic watcher, and EWMA ETA store.
# Bash 3.2+ parse-compatible; sourced by bin/update-all.
# Cross-module TUI state and palette globals are shared with bin/update-all and lib/runner.sh.
# shellcheck disable=SC2034,SC2154

UPDATE_ALL_ANIM="${UPDATE_ALL_ANIM:-1}"
UPDATE_ALL_DRY_RUN="${UPDATE_ALL_DRY_RUN:-0}"
UPDATE_ALL_BAR="${UPDATE_ALL_BAR:-bottom}"
UPDATE_ALL_WATCHER="${UPDATE_ALL_WATCHER:-hybrid}"
UPDATE_ALL_TIMINGS_FILE="${UPDATE_ALL_TIMINGS_FILE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/update-all/timings.tsv}"

_ua_term_rows="${_ua_term_rows:-24}"; _ua_term_cols="${_ua_term_cols:-80}"
_ua_tui_compact="${_ua_tui_compact:-0}"; _ua_tui_min_size_warned="${_ua_tui_min_size_warned:-0}"
_ua_tui_active="${_ua_tui_active:-0}"; _ua_tui_paused="${_ua_tui_paused:-0}"
_ua_tui_inline_visible="${_ua_tui_inline_visible:-0}"; _ua_tui_phase="${_ua_tui_phase:-INIT}"
_ua_tui_step_index="${_ua_tui_step_index:-0}"; _ua_tui_step_total="${_ua_tui_step_total:-0}"
_ua_tui_step_key="${_ua_tui_step_key:-}"; _ua_tui_step_label="${_ua_tui_step_label:-}"
_ua_tui_step_start_s="${_ua_tui_step_start_s:-0}"; _ua_tui_pct="${_ua_tui_pct:-0}"
_ua_tui_eta_str="${_ua_tui_eta_str:-calibrating...}"
_ua_tui_cnt_updated="${_ua_tui_cnt_updated:-0}"; _ua_tui_cnt_ok="${_ua_tui_cnt_ok:-0}"
_ua_tui_cnt_unchanged="${_ua_tui_cnt_unchanged:-0}"; _ua_tui_cnt_skip="${_ua_tui_cnt_skip:-0}"
_ua_tui_cnt_fail="${_ua_tui_cnt_fail:-0}"
_ua_timings_loaded="${_ua_timings_loaded:-0}"; _ua_timings_has_history="${_ua_timings_has_history:-0}"
_ua_timing_idx=-1; _ua_st_plain=""; _ua_st_col=""

if ! declare -p _ua_timing_keys >/dev/null 2>&1; then declare -a _ua_timing_keys=(); fi
if ! declare -p _ua_timing_secs >/dev/null 2>&1; then declare -a _ua_timing_secs=(); fi
if ! declare -p _ua_planned_keys >/dev/null 2>&1; then declare -a _ua_planned_keys=(); fi
if ! declare -p _ua_done_keys >/dev/null 2>&1; then declare -a _ua_done_keys=(); fi

anim_enabled() {
  [ "${UPDATE_ALL_ANIM:-1}" = "1" ] && [ "${UPDATE_ALL_DRY_RUN:-0}" = "0" ] \
    && [ -t 1 ] && [ "${CI:-}" != "true" ] && [ "${CI:-}" != "1" ] \
    && [ -n "${TERM:-}" ] && [ "${TERM:-}" != "dumb" ]
}

_tui_now_s() {
  local __out="$1"
  if [ "${BASH_VERSINFO[0]:-3}" -ge 5 ] || { [ "${BASH_VERSINFO[0]:-3}" -eq 4 ] && [ "${BASH_VERSINFO[1]:-0}" -ge 2 ]; }; then
    printf -v "$__out" '%(%s)T' -1
  else
    printf -v "$__out" '%s' "$(date +%s 2>/dev/null || echo 0)"
  fi
}

_tui_repeat_var() {
  local __out="$1" count="$2" ch="$3" spaces=""
  if [ "$count" -le 0 ]; then printf -v "$__out" '%s' ""; return 0; fi
  printf -v spaces '%*s' "$count" ''
  printf -v "$__out" '%s' "${spaces// /$ch}"
}

_tui_truncate_var() {
  local __out="$1" text="$2" max_len="$3" ell="…" ell_len=1
  if [ "${_ua_utf8:-1}" -eq 0 ]; then ell="..."; ell_len=3; fi
  if [ "$max_len" -le 0 ]; then printf -v "$__out" '%s' ""
  elif [ "${#text}" -le "$max_len" ]; then printf -v "$__out" '%s' "$text"
  elif [ "$max_len" -le "$ell_len" ]; then printf -v "$__out" '%s' "${text:0:$max_len}"
  else printf -v "$__out" '%s%s' "${text:0:$((max_len - ell_len))}" "$ell"
  fi
}

tui_query_size() {
  local sz="" r="" c=""
  [ -r /dev/tty ] && sz="$(stty size </dev/tty 2>/dev/null || true)"
  if [ -n "$sz" ]; then r="${sz%% *}"; c="${sz#* }"; fi
  case "$r" in *[!0-9]*|"") r="" ;; esac
  case "$c" in *[!0-9]*|"") c="" ;; esac
  if { [ -z "$r" ] || [ -z "$c" ]; } && command -v tput >/dev/null 2>&1; then
    r="$(tput lines 2>/dev/null || true)"
    c="$(tput cols 2>/dev/null || true)"
  fi
  case "$r" in *[!0-9]*|"") r=24 ;; esac
  case "$c" in *[!0-9]*|"") c=80 ;; esac
  [ "$r" -gt 0 ] || r=24; [ "$c" -gt 0 ] || c=80
  _ua_term_rows="$r"; _ua_term_cols="$c"
}

tui_rule_width() {
  local w=88
  if [ -t 1 ]; then
    [ "${_ua_term_cols:-0}" -gt 0 ] || tui_query_size
    w=$(( _ua_term_cols - 4 ))
    [ "$w" -lt 48 ] && w=48
    [ "$w" -gt 88 ] && w=88
  fi
  printf '%s' "$w"
}

tui_check_min_size() {
  if [ -t 1 ]; then
    tui_query_size
    if [ "$_ua_term_cols" -lt 60 ] || [ "$_ua_term_rows" -lt 14 ]; then
      _ua_tui_compact=1
      if [ "${_ua_tui_min_size_warned:-0}" -eq 0 ]; then
        _ua_tui_min_size_warned=1
        printf '   %b%s Tip:%b terminal is %sx%s; at least 80x24 is recommended for the full layout (continuing in compact mode).\n' \
          "${C_TIP:-}" "${G_WARN:-!}" "${C_RESET:-}" "$_ua_term_cols" "$_ua_term_rows"
      fi
      return 0
    fi
  fi
  _ua_tui_compact=0
}

tui_bar_enabled() {
  anim_enabled && [ "${UPDATE_ALL_BAR:-bottom}" != "off" ] \
    && [ "${BASH_VERSINFO[0]:-3}" -ge 4 ] \
    && [ "${_ua_term_rows:-0}" -ge 12 ] && [ "${_ua_term_cols:-0}" -ge 50 ]
}

_tui_watcher_glyph_var() {
  local __out="$1" tick="${2:-0}" style="${3:-${UPDATE_ALL_WATCHER:-hybrid}}"
  case "$tick" in *[!0-9]*|"") tick=0 ;; esac
  if [ "$style" = "off" ]; then printf -v "$__out" '%s' ""; return 0; fi
  if [ "${_ua_utf8:-1}" -eq 0 ]; then
    local -a ascii_f=('|' '/' '-' "\\")
    printf -v "$__out" '%s' "${ascii_f[$((tick % 4))]}"; return 0
  fi
  case "$style" in
    braille) local -a b_f=('⣾' '⣽' '⣻' '⢿' '⡿' '⣟' '⣯' '⣷'); printf -v "$__out" '%s' "${b_f[$((tick % 8))]}" ;;
    *) local -a a_f=('·' '✢' '✳' '✶' '✻' '✽' '✻' '✶' '✳' '✢'); printf -v "$__out" '%s' "${a_f[$((tick % 10))]}" ;;
  esac
}

tui_watcher_glyph() {
  local out=""; _tui_watcher_glyph_var out "${1:-0}" "${2:-${UPDATE_ALL_WATCHER:-hybrid}}"; printf '%s' "$out"
}

_tui_watcher_wave_var() {
  local __out="$1" tick="${2:-0}" style="${3:-${UPDATE_ALL_WATCHER:-hybrid}}"
  case "$tick" in *[!0-9]*|"") tick=0 ;; esac
  case "$style" in off|anthropic) printf -v "$__out" '%s' ""; return 0 ;; esac
  if [ "${_ua_utf8:-1}" -eq 0 ]; then
    local -a aw_f=('|/-' "/-\\" "-\\|" "\\|/")
    printf -v "$__out" '%s' "${aw_f[$((tick % 4))]}"; return 0
  fi
  local -a w_f=('⣿⣷⣯' '⣷⣯⣟' '⣯⣟⡿' '⣟⡿⢿' '⡿⢿⣻' '⢿⣻⣽' '⣻⣽⣾' '⣽⣾⣿')
  printf -v "$__out" '%s' "${w_f[$((tick % 8))]}"
}

tui_watcher_wave() {
  local out=""; _tui_watcher_wave_var out "${1:-0}" "${2:-${UPDATE_ALL_WATCHER:-hybrid}}"; printf '%s' "$out"
}

_tui_watcher_amber_var() {
  local __out="$1" tick="${2:-0}"
  case "$tick" in *[!0-9]*|"") tick=0 ;; esac
  if [ "${_ua_color_depth:-0}" -ge 256 ]; then
    local -a pulse=(208 214 215 221 223 230 223 221 215 214)
    printf -v "$__out" '\033[38;5;%sm' "${pulse[$((tick % 10))]}"
  else
    printf -v "$__out" '%s' "${C_ORANGE:-}"
  fi
}

_timings_find_index() {
  local key="$1" i n="${#_ua_timing_keys[@]}"
  _ua_timing_idx=-1
  for ((i = 0; i < n; i++)); do
    if [ "${_ua_timing_keys[$i]}" = "$key" ]; then _ua_timing_idx="$i"; return 0; fi
  done
  return 1
}

_timings_is_done() {
  local key="$1" i n="${#_ua_done_keys[@]}"
  for ((i = 0; i < n; i++)); do
    [ "${_ua_done_keys[$i]}" = "$key" ] && return 0
  done
  return 1
}

_timings_mark_done() {
  [ -n "$1" ] || return 0
  _timings_is_done "$1" || _ua_done_keys[${#_ua_done_keys[@]}]="$1"
}

timings_default_for_key() {
  case "$1" in
    safety|safety-brew|safety-osv|safety-ports|coverage|preflight|dpkg|ports) printf '3' ;;
    apt-update|dnf-check|pacman-sync|zypper-refresh|apk-update|xbps-sync) printf '10' ;;
    apt-upgrade|dnf-upgrade|rpm-ostree|pacman-upgrade|zypper-upgrade|apk-upgrade|xbps-upgrade) printf '35' ;;
    snap|flatpak) printf '20' ;;
    brew|brew-update|brew-upgrade) printf '25' ;;
    rustup|cargo|cargo-installed) printf '25' ;;
    corepack|pnpm|yarn|npm|npm-self|npm-globals) printf '15' ;;
    node|mise|volta|fnm|deno|bun|claude|codex|uv|pipx|gh|code) printf '12' ;;
    fwupd|firmware|cleanup|apt-cleanup|workstation-cleanup) printf '10' ;;
    *) printf '12' ;;
  esac
}

_timings_get_est_var() {
  if _timings_find_index "$2"; then printf -v "$1" '%s' "${_ua_timing_secs[$_ua_timing_idx]}"
  else printf -v "$1" '%s' "$(timings_default_for_key "$2")"
  fi
}

timings_get_estimate() {
  local est=""; _timings_get_est_var est "$1"; printf '%s' "$est"
}

timings_load() {
  local file="${1:-${UPDATE_ALL_TIMINGS_FILE:-}}" line="" key="" secs="" extra="" idx=0
  _ua_timing_keys=(); _ua_timing_secs=(); _ua_timings_loaded=1; _ua_timings_has_history=0
  [ -n "$file" ] && [ -r "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    case "$line" in \#*) continue ;; esac
    key=""; secs=""; extra=""
    IFS=$'\t' read -r key secs extra <<< "$line"
    [ -n "$key" ] && [ -n "$secs" ] && [ -z "$extra" ] || continue
    case "$key" in *[!A-Za-z0-9._:-]*) continue ;; esac
    case "$secs" in *[!0-9]*) continue ;; esac
    [ "$secs" -ge 1 ] && [ "$secs" -le 86400 ] || continue
    if _timings_find_index "$key"; then
      _ua_timing_secs[_ua_timing_idx]="$secs"
    else
      idx="${#_ua_timing_keys[@]}"
      _ua_timing_keys[idx]="$key"; _ua_timing_secs[idx]="$secs"
    fi
    _ua_timings_has_history=1
  done < "$file"
}

timings_set_planned_keys() {
  _ua_planned_keys=("$@"); _ua_done_keys=(); _ua_tui_step_total="$#"; _ua_tui_step_index=0
}

timings_record_step() {
  local key="$1" actual="${2:-1}" prev=0 ewma=1 idx=0
  [ -n "$key" ] || return 0
  actual="${actual%%.*}"
  case "$actual" in *[!0-9]*|"") actual=1 ;; esac
  [ "$actual" -lt 1 ] && actual=1
  _timings_mark_done "$key"
  if _timings_find_index "$key"; then
    prev="${_ua_timing_secs[$_ua_timing_idx]}"
    ewma=$(( (prev * 6 + actual * 4) / 10 ))
    [ "$ewma" -lt 1 ] && ewma=1
    _ua_timing_secs[_ua_timing_idx]="$ewma"
  else
    idx="${#_ua_timing_keys[@]}"
    _ua_timing_keys[idx]="$key"; _ua_timing_secs[idx]="$actual"
  fi
  _ua_timings_has_history=1
}

timings_save() {
  [ "${UPDATE_ALL_DRY_RUN:-0}" = "0" ] || return 0
  local file="${1:-${UPDATE_ALL_TIMINGS_FILE:-}}" dir="" tmp="" i=0 n="${#_ua_timing_keys[@]}"
  [ -n "$file" ] && [ "$n" -gt 0 ] || return 0
  dir="$(dirname -- "$file")"
  mkdir -p -- "$dir" 2>/dev/null || return 0
  tmp="$(mktemp "${dir}/.timings.XXXXXX" 2>/dev/null || printf '%s.tmp.%s' "$file" "$$")"
  if { for ((i = 0; i < n; i++)); do printf '%s\t%s\n' "${_ua_timing_keys[$i]}" "${_ua_timing_secs[$i]}"; done; } > "$tmp" 2>/dev/null; then
    mv -f -- "$tmp" "$file" 2>/dev/null || rm -f -- "$tmp" 2>/dev/null || true
  else
    rm -f -- "$tmp" 2>/dev/null || true
  fi
}

tui_format_duration() {
  local s="${1:-0}"; s="${s%%.*}"
  case "$s" in *[!0-9]*|"") s=0 ;; esac
  if [ "$s" -lt 60 ]; then printf '%ss' "$s"
  elif [ "$s" -lt 3600 ]; then printf '%sm %ss' "$((s / 60))" "$((s % 60))"
  else printf '%sh %sm' "$((s / 3600))" "$(((s % 3600) / 60))"
  fi
}

_tui_format_mmss_var() {
  local __out="$1" s="${2:-0}"; s="${s%%.*}"
  case "$s" in *[!0-9]*|"") s=0 ;; esac
  printf -v "$__out" '%02d:%02d' "$((s / 60))" "$((s % 60))"
}

_tui_update_progress() {
  local active_elapsed="${1:-0}" i=0 n_planned="${#_ua_planned_keys[@]}" n_done="${#_ua_done_keys[@]}"
  local total_est=0 done_est=0 active_est=0 est=0 cap=0 live=0 eff=0 pct=0 rem=0 k=""
  active_elapsed="${active_elapsed%%.*}"
  case "$active_elapsed" in *[!0-9]*|"") active_elapsed=0 ;; esac

  if [ "$n_planned" -gt 0 ]; then
    for ((i = 0; i < n_planned; i++)); do
      k="${_ua_planned_keys[$i]}"
      _timings_get_est_var est "$k"
      total_est=$(( total_est + est ))
      if _timings_is_done "$k"; then done_est=$(( done_est + est ))
      elif [ "$k" = "${_ua_tui_step_key:-}" ]; then active_est="$est"
      fi
    done
    if [ "$active_est" -gt 0 ]; then
      cap=$(( (active_est * 95) / 100 )); live="$active_elapsed"
      [ "$live" -gt "$cap" ] && live="$cap"
      eff=$(( done_est + live ))
    else eff="$done_est"
    fi
    [ "$total_est" -gt 0 ] && pct=$(( (eff * 100) / total_est ))
    [ "$pct" -lt 0 ] && pct=0; [ "$pct" -gt 100 ] && pct=100
    [ "$n_done" -lt "$n_planned" ] && [ "$pct" -ge 100 ] && pct=99
    rem=$(( total_est - eff )); [ "$rem" -lt 0 ] && rem=0
    if [ "${_ua_timings_has_history:-0}" -eq 0 ] && [ "$n_done" -eq 0 ]; then _ua_tui_eta_str="calibrating..."
    elif [ "$n_done" -ge "$n_planned" ]; then _ua_tui_eta_str="finishing..."
    else [ "$rem" -lt 1 ] && rem=1; _ua_tui_eta_str="~$(tui_format_duration "$rem") left"
    fi
  elif [ "${_ua_tui_step_total:-0}" -gt 0 ]; then
    local completed="$_ua_tui_step_index"
    [ -n "${_ua_tui_step_key:-}" ] && [ "$completed" -gt 0 ] && completed=$(( completed - 1 ))
    pct=$(( (completed * 100) / _ua_tui_step_total ))
    [ "$pct" -lt 0 ] && pct=0; [ "$pct" -gt 99 ] && [ -n "${_ua_tui_step_key:-}" ] && pct=99; [ "$pct" -gt 100 ] && pct=100
    _ua_tui_eta_str="calibrating..."
  else
    pct=0; _ua_tui_eta_str="calibrating..."
  fi
  _ua_tui_pct="$pct"
}

tui_calc_progress_pct() { _tui_update_progress "${1:-0}"; printf '%s' "$_ua_tui_pct"; }

tui_set_phase() {
  _ua_tui_phase="$1"
  if [ "${_ua_tui_active:-0}" -eq 1 ] && [ "${_ua_tui_paused:-0}" -eq 0 ]; then
    tui_draw_dock 0 0 0 1 || true
  fi
}

tui_step_begin() {
  local key="$1" label="${2:-$1}" idx="${3:-}" total="${4:-}"
  _ua_tui_step_key="$key"; _ua_tui_step_label="$label"
  if [ -n "$idx" ]; then _ua_tui_step_index="$idx"; else _ua_tui_step_index=$(( _ua_tui_step_index + 1 )); fi
  [ -n "$total" ] && _ua_tui_step_total="$total"
  _tui_now_s _ua_tui_step_start_s
  if [ "${_ua_tui_active:-0}" -eq 1 ] && [ "${_ua_tui_paused:-0}" -eq 0 ]; then
    tui_draw_dock 0 0 0 1 || true
  fi
}

tui_step_end() {
  local key="$1" status="${2:-OK}" actual="${3:-}" now_s=0
  case "$status" in
    UPDATED) _ua_tui_cnt_updated=$(( _ua_tui_cnt_updated + 1 )) ;;
    OK) _ua_tui_cnt_ok=$(( _ua_tui_cnt_ok + 1 )) ;;
    UNCHANGED) _ua_tui_cnt_unchanged=$(( _ua_tui_cnt_unchanged + 1 )) ;;
    SKIP) _ua_tui_cnt_skip=$(( _ua_tui_cnt_skip + 1 )) ;;
    FAIL) _ua_tui_cnt_fail=$(( _ua_tui_cnt_fail + 1 )) ;;
  esac
  if [ -z "$actual" ]; then
    _tui_now_s now_s; actual=$(( now_s - _ua_tui_step_start_s )); [ "$actual" -lt 1 ] && actual=1
  fi
  if [ "$status" = "SKIP" ]; then _timings_mark_done "$key"; else timings_record_step "$key" "$actual"; fi
  [ "${_ua_tui_step_key:-}" = "$key" ] && _ua_tui_step_key=""
  if [ "${_ua_tui_active:-0}" -eq 1 ] && [ "${_ua_tui_paused:-0}" -eq 0 ]; then
    tui_draw_dock 0 0 0 0 || true
  fi
}

_tui_apply_scroll_region() {
  if [ "${UPDATE_ALL_BAR:-bottom}" = "top" ]; then
    printf '\033[?2026h\033[3;%dr\033[3;1H\033[?2026l' "$_ua_term_rows"
  else
    local scroll_bot=$(( _ua_term_rows - 2 ))
    printf '\033[?2026h\n\n\033[2A\0337\033[1;%dr\0338\033[?2026l' "$scroll_bot"
  fi
}

tui_init() {
  tui_query_size
  tui_check_min_size
  if ! tui_bar_enabled; then
    _ua_tui_active=0
    return 0
  fi
  _tui_apply_scroll_region
  _ua_tui_active=1
  _ua_tui_paused=0
  tui_draw_dock 0 0 0 1
}

_tui_status_vars() {
  local alive="$1" silence="$2" dot="${G_SKIP:-·}"
  if [ "$alive" -eq 0 ]; then
    _ua_st_plain="${G_IDLE:-○} idle"
    _ua_st_col="${C_TIP:-}${_ua_st_plain}${C_RESET:-}"
  elif [ "$silence" -ge 45 ]; then
    _ua_st_plain="quiet ${silence}s (alive ${dot} Ctrl+C to stop)"
    _ua_st_col="${C_WARN:-}${_ua_st_plain}${C_RESET:-}"
  elif [ "$silence" -ge 15 ]; then
    _ua_st_plain="quiet ${silence}s (still running)"
    _ua_st_col="${C_WARN:-}${_ua_st_plain}${C_RESET:-}"
  else
    _ua_st_plain="${G_LIVE:-●} live"
    _ua_st_col="${C_OK:-}${_ua_st_plain}${C_RESET:-}"
  fi
}

tui_draw_dock() {
  [ "${_ua_tui_active:-0}" -eq 1 ] && [ "${_ua_tui_paused:-0}" -eq 0 ] || return 0
  local tick="${1:-0}" elapsed="${2:-0}" silence="${3:-0}" alive="${4:-1}"
  elapsed="${elapsed%%.*}"; silence="${silence%%.*}"
  case "$elapsed" in *[!0-9]*|"") elapsed=0 ;; esac
  case "$silence" in *[!0-9]*|"") silence=0 ;; esac

  _tui_update_progress "$elapsed"
  local r1=1 r2=2 max_cols=$(( _ua_term_cols - 1 ))
  if [ "${UPDATE_ALL_BAR:-bottom}" != "top" ]; then r1=$(( _ua_term_rows - 1 )); r2="$_ua_term_rows"; fi

  local bar_w=16
  if [ "$_ua_term_cols" -ge 100 ]; then bar_w=18
  elif [ "$_ua_term_cols" -lt 64 ]; then bar_w=8
  elif [ "$_ua_term_cols" -lt 80 ]; then bar_w=12
  fi
  local filled=$(( (_ua_tui_pct * bar_w) / 100 )) empty=0
  [ "$filled" -gt "$bar_w" ] && filled="$bar_w"
  empty=$(( bar_w - filled ))

  local fill_s="" empty_s="" pct_s="" dot="${G_SKIP:-·}" drule2="${G_DOCK_RULE:-━}${G_DOCK_RULE:-━}"
  _tui_repeat_var fill_s "$filled" "${G_BAR_FULL:-█}"
  _tui_repeat_var empty_s "$empty" "${G_BAR_EMPTY:-░}"
  printf -v pct_s '%3d%%' "$_ua_tui_pct"

  local step_s="Step ${_ua_tui_step_index}"
  [ "${_ua_tui_step_total:-0}" -gt 0 ] && step_s="Step ${_ua_tui_step_index}/${_ua_tui_step_total}"
  local cnt_plain="${G_UPDATED:-↗}${_ua_tui_cnt_updated} ${G_OK:-✓}${_ua_tui_cnt_ok} ${G_UNCHANGED:-=}${_ua_tui_cnt_unchanged} ${G_SKIP:-·}${_ua_tui_cnt_skip} ${G_FAIL:-✗}${_ua_tui_cnt_fail}"
  local cnt_col="${C_OK:-}${G_UPDATED:-↗}${_ua_tui_cnt_updated} ${G_OK:-✓}${_ua_tui_cnt_ok}${C_RESET:-} ${C_TIP:-}${G_UNCHANGED:-=}${_ua_tui_cnt_unchanged} ${G_SKIP:-·}${_ua_tui_cnt_skip}${C_RESET:-} ${C_BAD:-}${G_FAIL:-✗}${_ua_tui_cnt_fail}${C_RESET:-}"

  local row1="" r1_vis=0 sep_col="${C_FRAME:-} ${dot} ${C_RESET:-}"
  if [ "$max_cols" -ge 74 ]; then row1="${C_FRAME:-}${drule2}${C_RESET:-} "; r1_vis=3; fi
  row1="${row1}${C_FRAME:-}[${C_RESET:-}${C_BAR_FILL:-}${fill_s}${C_RESET:-}${C_BAR_BG:-}${empty_s}${C_RESET:-}${C_FRAME:-}]${C_RESET:-} ${C_HEADER:-}${pct_s}${C_RESET:-}"
  r1_vis=$(( r1_vis + bar_w + 3 + ${#pct_s} ))

  if [ $(( r1_vis + 3 + ${#_ua_tui_eta_str} )) -le "$max_cols" ]; then
    row1="${row1}${sep_col}${C_TIP:-}${_ua_tui_eta_str}${C_RESET:-}"; r1_vis=$(( r1_vis + 3 + ${#_ua_tui_eta_str} ))
  fi
  if [ $(( r1_vis + 3 + ${#step_s} )) -le "$max_cols" ]; then
    row1="${row1}${sep_col}${C_LABEL:-}${step_s}${C_RESET:-}"; r1_vis=$(( r1_vis + 3 + ${#step_s} ))
  fi
  if [ -n "${_ua_tui_phase:-}" ] && [ $(( r1_vis + 3 + ${#_ua_tui_phase} )) -le "$max_cols" ]; then
    row1="${row1}${sep_col}${C_UNIT:-}${_ua_tui_phase}${C_RESET:-}"; r1_vis=$(( r1_vis + 3 + ${#_ua_tui_phase} ))
  fi
  if [ $(( r1_vis + 3 + ${#cnt_plain} )) -le "$max_cols" ]; then
    row1="${row1}${sep_col}${cnt_col}"; r1_vis=$(( r1_vis + 3 + ${#cnt_plain} ))
  fi
  [ $(( r1_vis + 3 )) -le "$max_cols" ] && row1="${row1} ${C_FRAME:-}${drule2}${C_RESET:-}"
  row1="${row1}${C_RESET:-}"

  local glyph="" wave="" amber="" mmss="" wstyle="${UPDATE_ALL_WATCHER:-hybrid}"
  _tui_watcher_glyph_var glyph "$tick" "$wstyle"
  _tui_watcher_wave_var wave "$tick" "$wstyle"
  _tui_watcher_amber_var amber "$tick"
  _tui_format_mmss_var mmss "$elapsed"
  _tui_status_vars "$alive" "$silence"

  local prefix_vis=0 prefix_col="" right_vis=0 right_col="" label_raw="${_ua_tui_step_label:-Running update-all}" label_out=""
  if [ -n "$glyph" ]; then prefix_col="${amber}${glyph}${C_RESET:-} "; prefix_vis=2; fi
  if [ -n "$wave" ]; then
    right_vis=$(( 6 + ${#wave} + ${#mmss} + 3 + ${#_ua_st_plain} ))
    right_col="   ${C_BAR_FILL:-}${wave}${C_RESET:-}   ${C_TIP:-}${mmss}${C_RESET:-}${sep_col}${_ua_st_col}"
  else
    right_vis=$(( 2 + ${#mmss} + 3 + ${#_ua_st_plain} ))
    right_col="  ${C_TIP:-}${mmss}${C_RESET:-}${sep_col}${_ua_st_col}"
  fi
  local budget=$(( max_cols - prefix_vis - right_vis ))
  if [ "$budget" -lt 10 ] && [ -n "$wave" ]; then
    right_vis=$(( 2 + ${#mmss} + 3 + ${#_ua_st_plain} ))
    right_col="  ${C_TIP:-}${mmss}${C_RESET:-}${sep_col}${_ua_st_col}"
    budget=$(( max_cols - prefix_vis - right_vis ))
  fi
  if [ "$budget" -lt 6 ]; then
    right_vis=$(( 1 + ${#mmss} ))
    right_col=" ${C_TIP:-}${mmss}${C_RESET:-}"
    budget=$(( max_cols - prefix_vis - right_vis ))
  fi
  _tui_truncate_var label_out "$label_raw" "$budget"
  local row2="${prefix_col}${C_HEADER:-}${label_out}${C_RESET:-}${right_col}${C_RESET:-}"

  printf '\033[?2026h\0337\033[?25l\033[?7l\033[%d;1H\033[2K%s\033[%d;1H\033[2K%s\033[?7h\033[?25h\0338\033[?2026l' \
    "$r1" "$row1" "$r2" "$row2"
}

tui_handle_resize() {
  tui_query_size
  tui_check_min_size
  [ "${_ua_tui_active:-0}" -eq 1 ] || return 0
  if ! tui_bar_enabled; then tui_teardown; return 0; fi
  if [ "${_ua_tui_paused:-0}" -eq 0 ]; then
    if [ "${UPDATE_ALL_BAR:-bottom}" = "top" ]; then
      printf '\033[?2026h\0337\033[3;%dr\0338\033[?2026l' "$_ua_term_rows"
    else
      printf '\033[?2026h\0337\033[1;%dr\0338\033[?2026l' "$(( _ua_term_rows - 2 ))"
    fi
    tui_draw_dock 0 0 0 1
  fi
}

tui_pause_for_tty() {
  [ "${_ua_tui_active:-0}" -eq 1 ] && [ "${_ua_tui_paused:-0}" -eq 0 ] || return 0
  local r1=$(( _ua_term_rows - 1 )) r2="$_ua_term_rows"
  [ "${UPDATE_ALL_BAR:-bottom}" = "top" ] && r1=1 && r2=2
  printf '\033[?2026h\0337\033[%d;1H\033[2K\033[%d;1H\033[2K\033[r\033[?7h\033[?25h\033[0m\0338\033[?2026l' "$r1" "$r2"
  _ua_tui_paused=1
}

tui_resume_after_tty() {
  [ "${_ua_tui_paused:-0}" -eq 1 ] || return 0
  _ua_tui_paused=0
  tui_query_size
  if tui_bar_enabled; then
    _tui_apply_scroll_region
    _ua_tui_active=1
    tui_draw_dock 0 0 0 1
  else
    _ua_tui_active=0
  fi
}

tui_clear_inline_watcher() {
  if [ "${_ua_tui_inline_visible:-0}" -eq 1 ]; then
    printf '\r\033[2K'
    _ua_tui_inline_visible=0
  fi
}

tui_draw_inline_watcher() {
  anim_enabled || return 0
  [ "${_ua_tui_active:-0}" -eq 0 ] || return 0
  local tick="${1:-0}" elapsed="${2:-0}" silence="${3:-0}" label="${4:-${_ua_tui_step_label:-Running}}"
  local glyph="" wave="" amber="" mmss="" label_out="" dot="${G_SKIP:-·}"
  elapsed="${elapsed%%.*}"; silence="${silence%%.*}"
  case "$elapsed" in *[!0-9]*|"") elapsed=0 ;; esac
  case "$silence" in *[!0-9]*|"") silence=0 ;; esac

  _tui_watcher_glyph_var glyph "$tick" "${UPDATE_ALL_WATCHER:-hybrid}"
  _tui_watcher_wave_var wave "$tick" "${UPDATE_ALL_WATCHER:-hybrid}"
  _tui_watcher_amber_var amber "$tick"
  _tui_format_mmss_var mmss "$elapsed"
  _tui_status_vars 1 "$silence"

  local max_cols=$(( _ua_term_cols - 1 ))
  local sep_col="${C_FRAME:-} ${dot} ${C_RESET:-}"
  local right_vis=$(( 2 + ${#mmss} + 3 + ${#_ua_st_plain} ))
  local right_col="  ${C_TIP:-}${mmss}${C_RESET:-}${sep_col}${_ua_st_col}"
  if [ -n "$wave" ]; then
    right_vis=$(( 2 + ${#wave} + 2 + ${#mmss} + 3 + ${#_ua_st_plain} ))
    right_col="  ${C_BAR_FILL:-}${wave}${C_RESET:-}  ${C_TIP:-}${mmss}${C_RESET:-}${sep_col}${_ua_st_col}"
  fi
  local prefix_vis=$(( 3 + ${#glyph} + 1 ))
  local budget=$(( max_cols - prefix_vis - right_vis ))
  if [ "$budget" -lt 8 ] && [ -n "$wave" ]; then
    right_vis=$(( 2 + ${#mmss} + 3 + ${#_ua_st_plain} ))
    right_col="  ${C_TIP:-}${mmss}${C_RESET:-}${sep_col}${_ua_st_col}"
    budget=$(( max_cols - prefix_vis - right_vis ))
  fi
  if [ "$budget" -lt 6 ]; then
    right_vis=$(( 1 + ${#mmss} ))
    right_col=" ${C_TIP:-}${mmss}${C_RESET:-}"
    budget=$(( max_cols - prefix_vis - right_vis ))
  fi
  _tui_truncate_var label_out "$label" "$budget"
  printf '\r\033[2K   %s%s%s %s%s%s%s%s' \
    "$amber" "$glyph" "${C_RESET:-}" "${C_HEADER:-}" "$label_out" "${C_RESET:-}" "$right_col" "${C_RESET:-}"
  _ua_tui_inline_visible=1
}

tui_teardown() {
  tui_clear_inline_watcher
  if [ "${_ua_tui_active:-0}" -eq 1 ]; then
    local r1=$(( _ua_term_rows - 1 )) r2="$_ua_term_rows"
    [ "${UPDATE_ALL_BAR:-bottom}" = "top" ] && r1=1 && r2=2
    printf '\033[?2026h\0337\033[%d;1H\033[2K\033[%d;1H\033[2K\033[r\033[?7h\033[?25h\033[0m\0338\033[?2026l' "$r1" "$r2"
    _ua_tui_active=0
    _ua_tui_paused=0
  fi
}

# ===== MODULE: lib/runner.sh =====
# shellcheck shell=bash
# Zero-stall command runner, streaming redactor, and sudo engine for update-all.
# Strictly Bash 3.2+ parse-compatible (macOS bash 3.2.57 & Linux bash 5.x).
# Cross-module globals (palette, glyphs, TUI state, selftest flags) are shared with bin/update-all and sibling libs.
# shellcheck disable=SC2034,SC2154

UPDATE_ALL_STEP_TIMEOUT="${UPDATE_ALL_STEP_TIMEOUT:-600s}"
UPDATE_ALL_PROBE_TIMEOUT="${UPDATE_ALL_PROBE_TIMEOUT:-15s}"
UPDATE_ALL_DRY_RUN="${UPDATE_ALL_DRY_RUN:-0}"
UPDATE_ALL_NONINTERACTIVE="${UPDATE_ALL_NONINTERACTIVE:-0}"

_ua_tmp_dir="${_ua_tmp_dir:-}"; _ua_runtime_initialized="${_ua_runtime_initialized:-0}"
_ua_tools_probed="${_ua_tools_probed:-0}"; _ua_has_timeout="${_ua_has_timeout:-0}"
_ua_has_timeout_k="${_ua_has_timeout_k:-0}"; _ua_has_stdbuf="${_ua_has_stdbuf:-0}"
_ua_exiting="${_ua_exiting:-0}"
_ua_tui_resized="${_ua_tui_resized:-0}"; _ua_fifo_seq="${_ua_fifo_seq:-0}"
_ua_active_cmd_pid="${_ua_active_cmd_pid:-}"; _ua_active_filter_pid="${_ua_active_filter_pid:-}"
_ua_sudo_keepalive_pid="${_ua_sudo_keepalive_pid:-}"; _ua_sudo_keepalive_stopped="${_ua_sudo_keepalive_stopped:-0}"
_ua_needs_sudo="${_ua_needs_sudo:-0}"
_ua_last_tick_cs=0; _ua_last_tick_s=-1; _ua_w_tick=0

_UA_SECRET_HINT_RE='(sk-|github_pat_|gh[pousr]_|xox[baprs]-|AKIA[0-9A-Z]{16}|PRIVATE KEY-----|(TOKEN|PASSWORD|PASS|SECRET|API_KEY|APIKEY|ACCESS_KEY)[A-Za-z0-9_]*[[:space:]]*=)'

# ---------------------------------------------------------------------------
# 1. Unified Temp Dir & Trap Manager
# ---------------------------------------------------------------------------
_ua_probe_runner_tools() {
  [ "${_ua_tools_probed:-0}" -eq 0 ] || return 0
  _ua_tools_probed=1
  _ua_has_timeout=0
  _ua_has_timeout_k=0
  _ua_has_stdbuf=0
  if command -v timeout >/dev/null 2>&1; then
    _ua_has_timeout=1
    timeout -k 1s 2s true >/dev/null 2>&1 && _ua_has_timeout_k=1
  fi
  if command -v stdbuf >/dev/null 2>&1 && stdbuf -i0 -o0 true >/dev/null 2>&1; then
    _ua_has_stdbuf=1
  fi
}

_ua_reap_pid() {
  local pid="${1:-}" grace_tenths="${2:-15}" i=0
  [ -n "$pid" ] || return 0
  case "$grace_tenths" in
    *[!0-9]*|"") grace_tenths=15 ;;
  esac
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    while [ "$i" -lt "$grace_tenths" ] && kill -0 "$pid" 2>/dev/null; do
      if ! sleep 0.1 2>/dev/null; then
        sleep 1 2>/dev/null || true
        break
      fi
      i=$(( i + 1 ))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  wait "$pid" 2>/dev/null || true
}

ua_init_runtime() {
  _ua_probe_runner_tools
  if [ "${_ua_runtime_initialized:-0}" -eq 1 ] && [ -n "${_ua_tmp_dir:-}" ] && [ -d "$_ua_tmp_dir" ]; then
    return 0
  fi

  local base_tmp="${TMPDIR:-/tmp}"
  base_tmp="${base_tmp%/}"
  _ua_tmp_dir="$(mktemp -d "${base_tmp}/update-all.XXXXXX")"
  chmod 700 "$_ua_tmp_dir"
  _ua_exiting=0
  _ua_runtime_initialized=1

  trap '_ua_on_exit' EXIT
  trap '_ua_on_signal INT 130' INT
  trap '_ua_on_signal TERM 143' TERM
  trap '_ua_tui_resized=1' WINCH
}

_ua_on_exit() {
  [ "${_ua_exiting:-0}" -eq 0 ] || return 0
  _ua_exiting=1

  _ua_reap_pid "${_ua_active_cmd_pid:-}" 15
  _ua_active_cmd_pid=""
  _ua_reap_pid "${_ua_active_filter_pid:-}" 1
  _ua_active_filter_pid=""

  sudo_keepalive_stop
  declare -F tui_teardown >/dev/null 2>&1 && tui_teardown

  if [ -n "${_ua_tmp_dir:-}" ] && [ -d "$_ua_tmp_dir" ]; then
    rm -rf -- "$_ua_tmp_dir" 2>/dev/null || true
  fi
  _ua_tmp_dir=""
  _ua_runtime_initialized=0
}

_ua_on_signal() {
  local sig="${1:-INT}" code="${2:-130}"
  trap - INT TERM
  _ua_on_exit
  if [ "$sig" = "INT" ]; then
    printf '\n%bInterrupted (Ctrl+C). Terminal restored.%b\n' "${C_WARN:-}" "${C_RESET:-}" >&2
  fi
  exit "$code"
}

# ---------------------------------------------------------------------------
# 2. Fast-Path Redaction & Zero-Fork Coloring
# ---------------------------------------------------------------------------
redact_secrets() {
  local text="${1:-}"
  if [ -z "$text" ] || [[ ! "$text" =~ $_UA_SECRET_HINT_RE ]]; then
    printf '%s' "$text"
    return 0
  fi
  printf '%s' "$text" | sed -E \
    -e 's/sk-[A-Za-z0-9_-]{20,}/[REDACTED_OPENAI_KEY]/g' \
    -e 's/github_pat_[A-Za-z0-9_]{20,}/[REDACTED_GITHUB_TOKEN]/g' \
    -e 's/gh[pousr]_[A-Za-z0-9_]{20,}/[REDACTED_GITHUB_TOKEN]/g' \
    -e 's/xox[baprs]-[A-Za-z0-9-]{20,}/[REDACTED_SLACK_TOKEN]/g' \
    -e 's/AKIA[0-9A-Z]{16}/[REDACTED_AWS_ACCESS_KEY]/g' \
    -e 's/-----BEGIN [A-Z ]*PRIVATE KEY-----/[REDACTED_PRIVATE_KEY_BEGIN]/g' \
    -e 's/([A-Za-z_][A-Za-z0-9_]*(TOKEN|PASSWORD|PASS|SECRET|API_KEY|APIKEY|ACCESS_KEY)[A-Za-z0-9_]*[[:space:]]*=[[:space:]]*)[^[:space:]\[]+/\1[REDACTED]/g'
}

_ua_redact_into() {
  local __var="$1" text="$2" cleaned=""
  if [ -z "$text" ] || [[ ! "$text" =~ $_UA_SECRET_HINT_RE ]]; then
    printf -v "$__var" '%s' "$text"
    return 0
  fi
  cleaned="$(redact_secrets "$text")"
  printf -v "$__var" '%s' "$cleaned"
}

_ua_normalize_cr_into() {
  local __var="$1" raw="$2"
  if [[ "$raw" != *$'\r'* ]]; then
    printf -v "$__var" '%s' "$raw"
    return 0
  fi
  local rest="$raw" seg="" last=""
  while [ -n "$rest" ]; do
    if [[ "$rest" == *$'\r'* ]]; then
      seg="${rest%%$'\r'*}"
      rest="${rest#*$'\r'}"
    else
      seg="$rest"
      rest=""
    fi
    [ -n "${seg//[[:space:]]/}" ] && last="$seg"
  done
  printf -v "$__var" '%s' "$last"
}

color_log_line() {
  local line="${1:-}"
  if [ -z "$line" ]; then
    printf '\n'
    return 0
  fi

  local prefix=""
  if [ "${UPDATE_ALL_DRY_RUN:-0}" != 1 ] && [ "${UPDATE_ALL_REDACTION_SELFTEST:-0}" != 1 ] \
    && [ "${UPDATE_ALL_STDIN_SELFTEST:-0}" != 1 ] && [ -z "${UPDATE_ALL_SUDO_SELFTEST:-}" ] \
    && declare -F tui_bar_enabled >/dev/null 2>&1 && tui_bar_enabled; then
    prefix="${C_FRAME:-}    ${G_GUTTER:-│} ${C_RESET:-}"
  fi

  local had_nocasematch=0 color="${C_LOG:-}"
  shopt -q nocasematch && had_nocasematch=1
  shopt -s nocasematch

  if [[ "$line" == *error* || "$line" == *failed* || "$line" == *fatal* || "$line" == "e: "* || "$line" == *"cannot "* || "$line" == *"not found"* ]]; then
    color="${C_BAD:-}"
  elif [[ "$line" == *warn* || "$line" == *deprecated* || "$line" == *audit* || "$line" == *vulnerab* || "$line" == *notice* || "$line" == *"held back"* ]]; then
    color="${C_WARN:-}"
  elif [[ "$line" == *added* || "$line" == *changed* || "$line" == *updated* || "$line" == *upgraded* || "$line" == *installed* || "$line" == *success* || "$line" == *done* || "$line" == *"already up to date"* ]]; then
    color="${C_OK:-}"
  elif [[ "$line" == *removed* || "$line" == *removing* || "$line" == *autoremove* || "$line" == *prune* || "$line" == *cleanup* ]]; then
    color="${C_TIP:-}"
  elif [[ "$line" == *fund* || "$line" == *donation* ]]; then
    color="${C_TIP:-}"
  elif [[ "$line" == "preparing "*"@"*" for immediate activation"* ]]; then
    color="${C_APT_PROGRESS:-}"
  elif [[ "$line" == *@anthropic-ai/claude-code* || "$line" == *@openai/codex* || "$line" == *pnpm@* || "$line" == *npm@* || "$line" == *yarn@* ]]; then
    color="${C_HEADER:-}"
  elif [[ "$line" == "fetched "* || "$line" == "reading package lists"* || "$line" == "building dependency tree"* || "$line" == "reading state information"* ]]; then
    color="${C_APT_PROGRESS:-}"
  elif [[ "$line" == hit:* || "$line" == get:* || "$line" == ign:* ]]; then
    color="${C_APT_SOURCE:-}"
  fi

  [ "$had_nocasematch" -eq 0 ] && shopt -u nocasematch
  printf '%b%b%s%b\n' "$prefix" "$color" "$line" "${C_RESET:-}"
}

_ua_strip_nul_stream() {
  [ "${_ua_tools_probed:-0}" -eq 0 ] && _ua_probe_runner_tools
  if [ "${_ua_has_stdbuf:-0}" -eq 1 ]; then
    stdbuf -i0 -o0 tr -d '\000'
  else
    tr -d '\000'
  fi
}

color_log_stream() {
  local line
  _ua_strip_nul_stream | while IFS= read -r line || [ -n "$line" ]; do
    line="${line//^@/}"
    _ua_redact_into line "$line"
    color_log_line "$line"
  done
}

# ---------------------------------------------------------------------------
# 3. Single-Writer Live Concurrent Watcher Engine
# ---------------------------------------------------------------------------
_ua_now_cs_into() {
  local __var="$1" raw="${2:-${EPOCHREALTIME:-}}"
  [ -n "$raw" ] || return 1
  raw="${raw/[.,]/}"
  case "$raw" in
    *[!0-9]*|"") return 1 ;;
  esac
  [ "${#raw}" -gt 4 ] || return 1
  printf -v "$__var" '%s' "${raw:0:${#raw}-4}"
  return 0
}

_ua_watcher_tick() {
  local cmd_start_s="${1:-0}" last_out_s="${2:-0}" label="${3:-}" force="${4:-0}"

  if [ "${_ua_tui_resized:-0}" -eq 1 ]; then
    _ua_tui_resized=0
    declare -F tui_handle_resize >/dev/null 2>&1 && tui_handle_resize
  fi

  [ "${UPDATE_ALL_DRY_RUN:-0}" != 1 ] || return 0

  local use_dock=0 use_inline=0
  if [ "${_ua_tui_active:-0}" -eq 1 ]; then
    if [ "${_ua_tui_paused:-0}" -eq 0 ] && declare -F tui_draw_dock >/dev/null 2>&1; then
      use_dock=1
    fi
  elif declare -F anim_enabled >/dev/null 2>&1 && anim_enabled \
    && declare -F tui_draw_inline_watcher >/dev/null 2>&1; then
    use_inline=1
  fi
  [ "$use_dock" -eq 1 ] || [ "$use_inline" -eq 1 ] || return 0

  local now_cs=""
  if [ "$force" -eq 0 ]; then
    if [ "${BASH_VERSINFO[0]:-3}" -ge 5 ] && _ua_now_cs_into now_cs; then
      [ $(( 10#$now_cs - 10#${_ua_last_tick_cs:-0} )) -lt 10 ] && return 0
      _ua_last_tick_cs="$now_cs"
    else
      local now_s_chk="${SECONDS:-0}"
      [ "$now_s_chk" -eq "${_ua_last_tick_s:--1}" ] && return 0
      _ua_last_tick_s="$now_s_chk"
    fi
  else
    if [ "${BASH_VERSINFO[0]:-3}" -ge 5 ] && _ua_now_cs_into now_cs; then
      _ua_last_tick_cs="$now_cs"
    else
      _ua_last_tick_s="${SECONDS:-0}"
    fi
  fi

  local now_s="${SECONDS:-0}" elapsed=0 silence=0
  elapsed=$(( now_s - cmd_start_s ))
  [ "$elapsed" -lt 0 ] && elapsed=0
  silence=$(( now_s - last_out_s ))
  [ "$silence" -lt 0 ] && silence=0
  _ua_w_tick=$(( _ua_w_tick + 1 ))

  if [ "$use_dock" -eq 1 ]; then
    tui_draw_dock "$_ua_w_tick" "$elapsed" "$silence" 1
  else
    tui_draw_inline_watcher "$_ua_w_tick" "$elapsed" "$silence" "$label"
  fi
}

_ua_emit_watched_line() {
  local raw="$1" cap_file="$2" quiet="$3" had_cr=0 line=""
  raw="${raw//^@/}"
  [[ "$raw" == *$'\r'* ]] && had_cr=1
  _ua_normalize_cr_into line "$raw"
  [ "$had_cr" -eq 1 ] && [ -z "$line" ] && return 0

  _ua_redact_into line "$line"
  [ -n "$cap_file" ] && printf '%s\n' "$line" >> "$cap_file"
  if [ "$quiet" -eq 0 ]; then
    if [ "${_ua_tui_active:-0}" -eq 0 ] && [ "${_ua_tui_inline_visible:-0}" -eq 1 ] \
      && declare -F tui_clear_inline_watcher >/dev/null 2>&1; then
      tui_clear_inline_watcher
    fi
    color_log_line "$line"
  fi
}

_ua_exec_fallback() {
  local capture_var="$1" cap_file="$2" quiet="$3" secret_key="$4"
  shift 4
  local code=0 line=""

  if [ -n "$capture_var" ]; then
    if [ -n "$secret_key" ]; then
      secret get "$secret_key" 2>/dev/null | "$@" 2>&1 | _ua_strip_nul_stream \
        | while IFS= read -r line || [ -n "$line" ]; do _ua_emit_watched_line "$line" "$cap_file" "$quiet"; done
      code="${PIPESTATUS[1]}"
    else
      "$@" </dev/null 2>&1 | _ua_strip_nul_stream \
        | while IFS= read -r line || [ -n "$line" ]; do _ua_emit_watched_line "$line" "$cap_file" "$quiet"; done
      code="${PIPESTATUS[0]}"
    fi
    local captured=""
    if [ -f "$cap_file" ]; then
      captured="$(< "$cap_file")"
      rm -f -- "$cap_file"
    fi
    printf -v "$capture_var" '%s' "$captured"
    return "$code"
  fi

  if [ "$quiet" -eq 1 ]; then
    if [ -n "$secret_key" ]; then
      secret get "$secret_key" 2>/dev/null | "$@" >/dev/null 2>&1; code="${PIPESTATUS[1]}"
    else
      "$@" </dev/null >/dev/null 2>&1 || code=$?
    fi
  elif [ -n "$secret_key" ]; then
    secret get "$secret_key" 2>/dev/null | "$@" 2>&1 | color_log_stream; code="${PIPESTATUS[1]}"
  else
    "$@" </dev/null 2>&1 | color_log_stream; code="${PIPESTATUS[0]}"
  fi
  return "$code"
}

ua_exec_watched() {
  local capture_var="" quiet=0 limit="" label="" secret_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --capture) capture_var="${2:-}"; shift 2 ;;
      --quiet) quiet=1; shift ;;
      --timeout) limit="${2:-}"; shift 2 ;;
      --label) label="${2:-}"; shift 2 ;;
      --stdin-secret) secret_key="${2:-}"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  if [ $# -eq 0 ]; then
    [ -n "$capture_var" ] && printf -v "$capture_var" '%s' ''
    return 0
  fi
  if [ "${UPDATE_ALL_DRY_RUN:-0}" = 1 ]; then
    show_cmd "$@"
    [ -n "$capture_var" ] && printf -v "$capture_var" '%s' ''
    return 0
  fi

  ua_init_runtime

  local is_external=0 use_child_stdbuf=0
  type -P "$1" >/dev/null 2>&1 && is_external=1
  if [ "${_ua_has_stdbuf:-0}" -eq 1 ] && [ "$is_external" -eq 1 ]; then
    case "$1" in sudo|*/sudo) ;; *) use_child_stdbuf=1 ;; esac
  fi

  declare -a cmd_argv=()
  if [ -n "$limit" ] && [ "${_ua_has_timeout:-0}" -eq 1 ] && [ "$is_external" -eq 1 ]; then
    if [ "${_ua_has_timeout_k:-0}" -eq 1 ]; then
      cmd_argv=(timeout -k 10s "$limit")
    else
      cmd_argv=(timeout "$limit")
    fi
  fi
  [ "$use_child_stdbuf" -eq 1 ] && cmd_argv+=(stdbuf -oL -eL)
  cmd_argv+=("$@")

  _ua_fifo_seq=$(( _ua_fifo_seq + 1 ))
  local stem="$_ua_tmp_dir/cmd.${BASHPID:-$$}.${_ua_fifo_seq}"
  local raw_fifo="${stem}.raw.fifo" out_fifo="${stem}.out.fifo" cap_file=""

  if [ -n "$capture_var" ]; then
    cap_file="${stem}.cap"
    : > "$cap_file"
    chmod 600 "$cap_file"
  fi

  if ! mkfifo -m 600 "$raw_fifo" "$out_fifo" 2>/dev/null; then
    rm -f -- "$raw_fifo" "$out_fifo" 2>/dev/null || true
    _ua_exec_fallback "$capture_var" "$cap_file" "$quiet" "$secret_key" "${cmd_argv[@]}"
    return $?
  fi

  local monitor_was_on=0
  case "$-" in *m*) monitor_was_on=1; set +m ;; esac

  local filter_pid=""
  if [ "${_ua_has_stdbuf:-0}" -eq 1 ]; then
    stdbuf -i0 -o0 tr -d '\000' < "$raw_fifo" > "$out_fifo" &
  else
    tr -d '\000' < "$raw_fifo" > "$out_fifo" &
  fi
  filter_pid=$!
  _ua_active_filter_pid="$filter_pid"

  local cmd_pid=""
  if [ -n "$secret_key" ]; then
    "${cmd_argv[@]}" < <(secret get "$secret_key" 2>/dev/null) > "$raw_fifo" 2>&1 &
  else
    "${cmd_argv[@]}" </dev/null > "$raw_fifo" 2>&1 &
  fi
  cmd_pid=$!
  _ua_active_cmd_pid="$cmd_pid"
  [ "$monitor_was_on" -eq 1 ] && set -m

  local prev_w_tick="${_ua_w_tick:-0}" saved_step_label=0
  _ua_w_tick=0
  local cmd_start_s="${SECONDS:-0}" last_out_s="${SECONDS:-0}"
  if [ -n "$label" ] && [ -z "${_ua_tui_step_label:-}" ]; then
    _ua_tui_step_label="$label"
    saved_step_label=1
  fi

  exec 3< "$out_fifo"
  _ua_watcher_tick "$cmd_start_s" "$last_out_s" "$label" 1

  local line="" pending="" read_rc=0 dead_ticks=0 is_bash4=0
  [ "${BASH_VERSINFO[0]:-3}" -ge 4 ] && is_bash4=1

  while true; do
    line=""
    read_rc=0
    if [ "$is_bash4" -eq 1 ]; then
      IFS= read -r -t 0.08 line <&3 || read_rc=$?
    else
      IFS= read -r -t 1 line <&3 || read_rc=$?
    fi

    if [ "$read_rc" -eq 0 ]; then
      dead_ticks=0
      last_out_s="${SECONDS:-0}"
      if [ -n "$pending" ]; then line="${pending}${line}"; pending=""; fi
      _ua_emit_watched_line "$line" "$cap_file" "$quiet"
      _ua_watcher_tick "$cmd_start_s" "$last_out_s" "$label" 0
      continue
    fi

    if [ "$is_bash4" -eq 1 ] && [ "$read_rc" -le 128 ]; then
      line="${pending}${line}"
      [ -n "$line" ] && _ua_emit_watched_line "$line" "$cap_file" "$quiet"
      break
    fi

    if [ -n "$line" ]; then
      last_out_s="${SECONDS:-0}"
      pending="${pending}${line}"
      [[ "$pending" == *$'\r'* ]] && _ua_normalize_cr_into pending "$pending"
    fi
    _ua_watcher_tick "$cmd_start_s" "$last_out_s" "$label" 0

    if [ "$is_bash4" -eq 1 ]; then
      if ! kill -0 "$cmd_pid" 2>/dev/null; then
        dead_ticks=$(( dead_ticks + 1 ))
        if [ "$dead_ticks" -ge 3 ]; then
          [ -n "$pending" ] && _ua_emit_watched_line "$pending" "$cap_file" "$quiet"
          break
        fi
      fi
    else
      if ! kill -0 "$filter_pid" 2>/dev/null; then
        [ -n "$pending" ] && _ua_emit_watched_line "$pending" "$cap_file" "$quiet"
        break
      fi
      if ! kill -0 "$cmd_pid" 2>/dev/null; then
        dead_ticks=$(( dead_ticks + 1 ))
        if [ "$dead_ticks" -ge 2 ]; then
          [ -n "$pending" ] && _ua_emit_watched_line "$pending" "$cap_file" "$quiet"
          break
        fi
      fi
    fi
  done

  exec 3<&-
  declare -F tui_clear_inline_watcher >/dev/null 2>&1 && tui_clear_inline_watcher
  _ua_w_tick="$prev_w_tick"
  [ "$saved_step_label" -eq 1 ] && _ua_tui_step_label=""

  local cmd_rc=0
  wait "$cmd_pid" 2>/dev/null || cmd_rc=$?
  _ua_active_cmd_pid=""

  if kill -0 "$filter_pid" 2>/dev/null; then
    _ua_reap_pid "$filter_pid" 1
  else
    wait "$filter_pid" 2>/dev/null || true
  fi
  _ua_active_filter_pid=""
  rm -f -- "$raw_fifo" "$out_fifo" 2>/dev/null || true

  if [ -n "$capture_var" ]; then
    local captured=""
    if [ -f "$cap_file" ]; then
      captured="$(< "$cap_file")"
      rm -f -- "$cap_file"
    fi
    printf -v "$capture_var" '%s' "$captured"
  fi
  return "$cmd_rc"
}

# ---------------------------------------------------------------------------
# 4. Runner Wrappers
# ---------------------------------------------------------------------------
show_cmd() { printf '%b$%b' "${C_CMD:-}" "${C_RESET:-}"; printf ' %q' "$@"; printf '\n'; }

run_bounded() {
  local limit="$1"; shift
  if [ "${UPDATE_ALL_DRY_RUN:-0}" = 1 ]; then show_cmd "$@"; return 0; fi
  ua_exec_watched --timeout "$limit" -- "$@"
}

run_cmd() { ua_exec_watched --timeout "${UPDATE_ALL_STEP_TIMEOUT:-600s}" -- "$@"; }

run_cmd_capture() {
  local __var="$1"; shift
  ua_exec_watched --capture "$__var" --timeout "${UPDATE_ALL_STEP_TIMEOUT:-600s}" -- "$@"
}

run_cmd_capture_quiet() {
  local __var="$1"; shift
  ua_exec_watched --capture "$__var" --quiet --timeout "${UPDATE_ALL_PROBE_TIMEOUT:-15s}" -- "$@"
}

run_shell() {
  ua_exec_watched --timeout "${UPDATE_ALL_STEP_TIMEOUT:-600s}" -- \
    env -u BASH_ENV -u ENV bash --noprofile --norc -c "$1"
}

run_shell_capture() {
  ua_exec_watched --capture "$1" --timeout "${UPDATE_ALL_STEP_TIMEOUT:-600s}" -- \
    env -u BASH_ENV -u ENV bash --noprofile --norc -c "$2"
}

run_probe_bounded() {
  local limit="$1"; shift
  [ "${_ua_tools_probed:-0}" -eq 0 ] && _ua_probe_runner_tools
  if [ "${_ua_has_timeout:-0}" -eq 1 ]; then
    if [ "${_ua_has_timeout_k:-0}" -eq 1 ]; then
      timeout -k 3s "$limit" "$@" </dev/null 2>/dev/null
    else
      timeout "$limit" "$@" </dev/null 2>/dev/null
    fi
  else
    "$@" </dev/null 2>/dev/null
  fi
}

# ---------------------------------------------------------------------------
# 5. Rock-Solid Sudo Engine & Keepalive
# ---------------------------------------------------------------------------
sudo_secret_available() {
  [ -n "${UPDATE_ALL_SUDO_SECRET_KEY:-}" ] || return 1
  command -v secret >/dev/null 2>&1 || return 1
  secret has "$UPDATE_ALL_SUDO_SECRET_KEY" 2>/dev/null
}

_ua_sudo_exec() {
  local capture_var="$1"; shift
  if [ "${UPDATE_ALL_DRY_RUN:-0}" = 1 ]; then
    show_cmd sudo "$@"
    [ -n "$capture_var" ] && printf -v "$capture_var" '%s' ''
    return 0
  fi

  declare -a watch_args=(--timeout "${UPDATE_ALL_STEP_TIMEOUT:-600s}")
  [ -n "$capture_var" ] && watch_args+=(--capture "$capture_var")

  if ! command -v sudo >/dev/null 2>&1; then
    ua_exec_watched "${watch_args[@]}" -- "$@"
    return $?
  fi
  if sudo -n true </dev/null 2>/dev/null; then
    ua_exec_watched "${watch_args[@]}" -- sudo -n "$@"
    return $?
  fi
  if sudo_secret_available; then
    ua_exec_watched "${watch_args[@]}" --stdin-secret "$UPDATE_ALL_SUDO_SECRET_KEY" -- sudo -S -p '' "$@"
    return $?
  fi

  if [ -t 0 ] && [ -t 1 ] && [ "${UPDATE_ALL_NONINTERACTIVE:-0}" != 1 ]; then
    declare -F tui_pause_for_tty >/dev/null 2>&1 && tui_pause_for_tty
    printf '\n%bSudo session expired — please re-authenticate:%b\n' "${C_WARN:-}" "${C_RESET:-}" >&2
    local auth_rc=0
    # shellcheck disable=SC2024 # Reading password from the controlling TTY is intentional.
    sudo -v </dev/tty || auth_rc=$?
    declare -F tui_resume_after_tty >/dev/null 2>&1 && tui_resume_after_tty
    if [ "$auth_rc" -ne 0 ]; then
      [ -n "$capture_var" ] && printf -v "$capture_var" '%s' ''
      return "$auth_rc"
    fi
    ua_exec_watched "${watch_args[@]}" -- sudo -n "$@"
    return $?
  fi

  printf '%bsudo authentication required, but running non-interactively (cannot prompt for password).%b\n' \
    "${C_BAD:-}" "${C_RESET:-}" >&2
  [ -n "$capture_var" ] && printf -v "$capture_var" '%s' ''
  return 1
}

sudo_cmd() { _ua_sudo_exec "" "$@"; }

sudo_cmd_capture() {
  local __var="$1"; shift
  _ua_sudo_exec "$__var" "$@"
}

sudo_noninteractive_apt() {
  sudo_cmd env DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true \
    NEEDRESTART_MODE=l UCF_FORCE_CONFFOLD=1 APT_LISTCHANGES_FRONTEND=none \
    PAGER=cat TERM=dumb "$@"
}

sudo_keepalive_stop() {
  [ "${_ua_sudo_keepalive_stopped:-0}" -eq 0 ] || return 0
  _ua_sudo_keepalive_stopped=1
  if [ -n "${_ua_sudo_keepalive_pid:-}" ]; then
    kill -TERM "$_ua_sudo_keepalive_pid" 2>/dev/null || true
    wait "$_ua_sudo_keepalive_pid" 2>/dev/null || true
    _ua_sudo_keepalive_pid=""
  fi
}

prime_sudo() {
  [ "${UPDATE_ALL_DRY_RUN:-0}" = 0 ] || return 0
  if [ "${_ua_needs_sudo:-0}" != 1 ] && [ -z "${UPDATE_ALL_SUDO_SELFTEST:-}" ]; then
    return 0
  fi
  command -v sudo >/dev/null 2>&1 || return 0
  sudo_secret_available && return 0

  if ! sudo -n true 2>/dev/null; then
    if [ "${UPDATE_ALL_NONINTERACTIVE:-0}" = 1 ] || [ ! -t 0 ] || [ ! -t 1 ]; then
      printf '%bsudo authentication required, but running non-interactively (cannot prompt for password).%b\n' \
        "${C_BAD:-}" "${C_RESET:-}" >&2
      return 1
    fi
    # shellcheck disable=SC2024 # Reading password from the controlling TTY is intentional.
    sudo -v </dev/tty || return $?
  fi

  sudo_keepalive_stop
  _ua_sudo_keepalive_stopped=0

  local parent_pid="$$" monitor_was_on=0
  case "$-" in *m*) monitor_was_on=1; set +m ;; esac
  {
    (
      exec </dev/null >/dev/null 2>&1
      while kill -0 "$parent_pid" 2>/dev/null; do
        sleep 30 &
        _sp=$!
        trap 'kill "$_sp" 2>/dev/null || true; exit 0' INT TERM
        wait "$_sp" 2>/dev/null || exit 0
        sudo -n -v >/dev/null 2>&1 || exit 0
      done
    ) &
    _ua_sudo_keepalive_pid=$!
  } 2>/dev/null
  [ "$monitor_was_on" -eq 1 ] && set -m
  return 0
}

