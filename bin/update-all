# ---------------------------------------------------------------------------
# Module loader (replaced inline by scripts/build-standalone.sh in dist builds)
# ---------------------------------------------------------------------------
# __UA_BUNDLE_LOADER_BEGIN__
_ua_resolve_script_dir() {
  local src="${BASH_SOURCE[0]}" dir target
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$dir/$target" ;;
    esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

if [ "${_UA_BUNDLED:-0}" != 1 ]; then
  _ua_bin_dir="$(_ua_resolve_script_dir)"
  _ua_lib_dir="${_ua_bin_dir}/../lib"
  for _ua_mod in \
    colors_and_glyphs.sh \
    tui.sh \
    runner.sh \
    discover.sh \
    updaters.sh \
    cleanup.sh \
    safety_coach.sh \
    receipt.sh; do
    if [ ! -r "$_ua_lib_dir/$_ua_mod" ]; then
      printf 'update-all: missing module %s\n' "$_ua_lib_dir/$_ua_mod" >&2
      exit 1
    fi
    # shellcheck source=/dev/null
    . "$_ua_lib_dir/$_ua_mod"
  done
  unset _ua_bin_dir _ua_lib_dir _ua_mod
fi
# __UA_BUNDLE_MODULES_HERE__

# ---------------------------------------------------------------------------
# CLI usage & argument parsing
# ---------------------------------------------------------------------------
usage() {
  cat <<'EOF'
update-all - universal local-first Linux workstation updater

Usage:
  update-all [options]

Options:
  --dry-run                    Print each update command without applying updates.
  -a, --all                    Auto-approve all safe updates & cache cleanup (zero upfront prompts).
                               Firmware flashing remains opt-in (--firmware); Safety Coach findings
                               still show an interactive remedy walkthrough at the end.
  --firmware                   Opt in to applying installable Linux firmware updates (fwupdmgr).
  --no-anim                    Disable live watcher animations and pinned TUI bar.
  --no-color                   Disable ANSI color output (also honors NO_COLOR).
  --no-security-scan           Skip OSV malicious/advisory and open-port Safety Coach scans.
  --non-interactive            Never prompt for keyboard input (print actionable remedies instead).
  --watcher=MODE               Live watcher style: hybrid (default), braille, or anthropic.
  --bar=POS                    Persistent TUI progress bar: bottom (default), top, or off.
  -h, --help                   Show this help.

Interactive:
  At optional live prompts, type a or all once to answer yes to every remaining
  safe cleanup question in that run, or pass -a/--all from the command line.

Environment:
  UPDATE_ALL_PROBE_TIMEOUT=15s     Timeout for version & preflight probes.
  UPDATE_ALL_COREPACK_TIMEOUT=90s  Timeout for corepack commands.
  UPDATE_ALL_NODE_TIMEOUT=300s     Timeout for update-node.
  UPDATE_ALL_STEP_TIMEOUT=600s     Default timeout for package manager updates.
  UPDATE_ALL_BUILD_TIMEOUT=1200s   Timeout for source builds (e.g. cargo).
  UPDATE_ALL_WATCHER=hybrid        Watcher style: hybrid | braille | anthropic.
  UPDATE_ALL_BAR=bottom            Dock bar position: bottom | top | off.
  UPDATE_ALL_ANIM=0                Disable terminal animations.
  UPDATE_ALL_COLOR=0               Disable ANSI colors.
  UPDATE_ALL_SECURITY_SCAN=0       Disable Safety Coach scans.
  UPDATE_ALL_SUDO_SECRET_KEY=name  Optional `secret` helper key for sudo.
EOF
}

parse_args() {
  local val
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)
        UPDATE_ALL_DRY_RUN=1
        ;;
      -a|--all)
        _ua_answer_all_choice="yes"
        ;;
      --firmware)
        UPDATE_ALL_FIRMWARE_FLAG=1
        _ua_firmware_choice="yes"
        ;;
      --no-anim)
        UPDATE_ALL_ANIM=0
        ;;
      --no-color)
        UPDATE_ALL_COLOR=0
        ;;
      --no-security-scan)
        UPDATE_ALL_SECURITY_SCAN=0
        ;;
      --non-interactive)
        UPDATE_ALL_NONINTERACTIVE=1
        ;;
      --watcher=*)
        val="${1#--watcher=}"
        case "$val" in
          hybrid|braille|anthropic) UPDATE_ALL_WATCHER="$val" ;;
          *)
            printf 'update-all: invalid --watcher value: %s (expected hybrid, braille, or anthropic)\n\n' "$val" >&2
            usage >&2
            exit 2
            ;;
        esac
        ;;
      --bar=*)
        val="${1#--bar=}"
        case "$val" in
          bottom|top|off) UPDATE_ALL_BAR="$val" ;;
          *)
            printf 'update-all: invalid --bar value: %s (expected bottom, top, or off)\n\n' "$val" >&2
            usage >&2
            exit 2
            ;;
        esac
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        printf 'update-all: unknown option: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

# ---------------------------------------------------------------------------
# Selftest dispatcher (supports automated unit/PTY/visual test harnesses)
# ---------------------------------------------------------------------------
_ua_run_selftests() {
  local i

  if [ "${UPDATE_ALL_PROMPT_SELFTEST:-0}" = 1 ]; then
    discover_host
    discover_environment
    collect_optional_choices
    printf 'firmware choice: %s\n' "$_ua_firmware_choice"
    for ((i = 0; i < ${#_ua_brew_taps[@]}; i++)); do
      printf 'brew untap %s: %s\n' "${_ua_brew_taps[$i]}" "${_ua_brew_untap_choices[$i]}"
    done
    printf 'apt cleanup choice: %s\n' "$_ua_apt_cleanup_choice"
    printf 'workstation cleanup choice: %s\n' "$_ua_workstation_cleanup_choice"
    return 0
  fi

  if [ "${UPDATE_ALL_REDACTION_SELFTEST:-0}" = 1 ]; then
    color_log_stream
    return 0
  fi

  if [ "${UPDATE_ALL_STDIN_SELFTEST:-0}" = 1 ]; then
    local stdin_selftest_output
    run_cmd bash -c 'if IFS= read -r -t 1 _; then echo run-cmd-open; else echo run-cmd-closed; fi'
    run_cmd_capture stdin_selftest_output bash -c 'if IFS= read -r -t 1 _; then echo run-capture-open; else echo run-capture-closed; fi'
    run_bounded 5s bash -c 'if IFS= read -r -t 1 _; then echo run-bounded-open; else echo run-bounded-closed; fi'
    run_shell 'if IFS= read -r -t 1 _; then echo run-shell-open; else echo run-shell-closed; fi'
    run_shell_capture stdin_selftest_output 'if IFS= read -r -t 1 _; then echo run-shell-capture-open; else echo run-shell-capture-closed; fi'
    if [ "${UPDATE_ALL_STDIN_INCLUDE_SUDO:-0}" = 1 ]; then
      sudo_cmd bash -c 'if IFS= read -r -t 1 _; then echo sudo-cmd-open; else echo sudo-cmd-closed; fi'
    fi
    : "$stdin_selftest_output"
    return 0
  fi

  if [ "${UPDATE_ALL_SUDO_SELFTEST:-}" = "secret-prime" ]; then
    _ua_needs_sudo=1
    prime_sudo || return $?
    sudo_cmd printf 'sudo command ok\n'
    local sudo_selftest_code=$?
    sudo_keepalive_stop
    return "$sudo_selftest_code"
  fi

  if [ "${UPDATE_ALL_FIRMWARE_SELFTEST:-}" = "summary" ]; then
    local firmware_selftest_output
    firmware_selftest_output="$(cat)"
    print_firmware_summary "$firmware_selftest_output"
    return 0
  fi

  if [ "${UPDATE_ALL_RECEIPT_SELFTEST:-}" = "visual" ]; then
    receipt_visual_selftest
    return $?
  fi

  if [ "${UPDATE_ALL_VISUAL_PREVIEW:-0}" = 1 ]; then
    visual_preview_all
    return $?
  fi

  if [ "${UPDATE_ALL_CLASSIFY_SELFTEST:-}" = "fwupd-manual" ]; then
    fwupd_needs_manual_attention
    return $?
  fi
  if [ "${UPDATE_ALL_CLASSIFY_SELFTEST:-}" = "npm-claude-script" ]; then
    npm_output_needs_claude_script_retry
    return $?
  fi
  if [ "${UPDATE_ALL_CLASSIFY_SELFTEST:-}" = "uv-stale-extra" ]; then
    uv_output_has_stale_extra_warning
    return $?
  fi
  if [ "${UPDATE_ALL_CLASSIFY_SELFTEST:-}" = "updated-output" ]; then
    output_implies_update
    return $?
  fi

  if [ -n "${UPDATE_ALL_WATCHER_SELFTEST:-}" ]; then
    case "$UPDATE_ALL_WATCHER_SELFTEST" in
      frames)
        local st g
        for st in hybrid braille anthropic; do
          g="$(tui_watcher_glyph 0 "$st")"
          printf 'style=%s frame0=%s\n' "$st" "$g"
        done
        return 0
        ;;
      stream-capture)
        local cap_out="" cap_rc=0 syn_tok
        syn_tok="sk-""1234567890abcdefghijklmno"
        # shellcheck disable=SC2016
        run_cmd_capture cap_out bash -c 'printf "line-one\n"; sleep 0.2; printf "token=%s\000tail\n" "$1"; exit 7' _ "$syn_tok"
        cap_rc=$?
        printf 'CAPTURE_RC=%s\n' "$cap_rc"
        printf 'CAPTURE_VAL=%s\n' "$cap_out"
        return 0
        ;;
      leaked-fd)
        run_cmd bash -c '(sleep 5) & printf "parent-done\n"; exit 0'
        return $?
        ;;
      pty-bar)
        timings_set_planned_keys "selftest-step" "selftest-two"
        tui_set_phase "TOOLS"
        tui_init
        tui_step_begin "selftest-step" "Testing live dock"
        run_cmd bash -c 'printf "tick-start\n"; sleep 0.35; printf "tick-end\n"'
        tui_step_end "selftest-step" "OK"
        tui_teardown
        return 0
        ;;
      timings)
        timings_load
        timings_set_planned_keys "apt-upgrade" "brew-upgrade"
        timings_record_step "apt-upgrade" 30
        timings_save
        printf 'EST_APT=%s\n' "$(timings_get_estimate "apt-upgrade")"
        return 0
        ;;
    esac
  fi

  if [ -n "${UPDATE_ALL_SAFETY_SELFTEST:-}" ]; then
    case "$UPDATE_ALL_SAFETY_SELFTEST" in
      osv)
        scan_osv_packages
        run_safety_coach_remedy
        return 0
        ;;
      ports)
        scan_public_ports
        run_safety_coach_remedy
        return 0
        ;;
      full)
        scan_osv_packages
        scan_public_ports
        run_safety_coach_remedy
        return 0
        ;;
    esac
  fi

  return 250
}

# ---------------------------------------------------------------------------
# Main entrypoint
# ---------------------------------------------------------------------------
main() {
  local st_rc
  parse_args "$@"
  ua_init_runtime
  augment_safe_path
  color_init
  tui_query_size

  _ua_run_selftests
  st_rc=$?
  if [ "$st_rc" -ne 250 ]; then
    return "$st_rc"
  fi

  _ua_started_s="$(date +%s)"
  _ua_started_h="$(date '+%Y-%m-%d %H:%M:%S %Z')"

  intro
  tui_check_min_size
  discover_host
  discover_environment
  timings_load
  collect_optional_choices
  prime_sudo || return $?

  tui_init
  run_updates
  sudo_keepalive_stop
  timings_save
  tui_teardown

  report
  run_safety_coach_remedy
  return "$rc"
}

main "$@"
