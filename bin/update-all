#!/usr/bin/env bash
# Universal, local-first Linux workstation updater with live TUI dock and Safety Coach.
# Public-safe: no secrets are stored here; an optional `secret` helper may supply
# sudo only when it already exists on the host.
# shellcheck disable=SC2034 # Shared config and state globals are read by sourced lib/*.sh modules.
set -uo pipefail

